# --- ZORUNLU AYARLAR ---
# Docker kurulumunda DATABASE_URL otomatik yönetilir (docker-compose üzerinden).
# Eğer yerel (local) çalıştıracaksanız aşağıdaki formatı kullanın:
DATABASE_URL="postgresql://postgres:SproSecret123!@db:5432/sozlesmepro"
NEXTAUTH_SECRET="en-az-32-karakterli-rastgele-bir-dizi"
NEXTAUTH_URL="http://localhost:3000"
NODE_ENV="production"
PORT=3000
AUTH_SECRET="en-az-32-karakterli-rastgele-bir-dizi"

# --- ADMİN HESABI ---
# İlk kurulumda bu bilgilerle giriş yaparsanız otomatik admin hesabı oluşturulacaktır.
ADMIN_EMAIL="admin@sozlesmepro.com"
ADMIN_PASSWORD="admin_parolaniz_buraya"
DEFAULT_COMPANY_NAME="SozlesmePRO Kurumsal"

# --- E-POSTA AYARLARI (OPSİYONEL) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="hesabiniz@gmail.com"
SMTP_PASS="uygulama-sifresi"
SMTP_FROM_EMAIL="hesabiniz@gmail.com"
SMTP_FROM_NAME="SözleşmePRO Bildirim"

# --- DOSYA YÜKLEME ---
UPLOAD_DIR="/app/uploads"
MAX_FILE_SIZE=10485760
